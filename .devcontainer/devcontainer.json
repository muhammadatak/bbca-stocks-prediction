{
  "name": "Stocks Prediction - MLflow",
  "image": "mcr.microsoft.com/devcontainers/python:3.11",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "postCreateCommand": "bash setup_codespaces.sh",
  "forwardPorts": [5000, 5001, 5002, 5003],
  "portsAttributes": {
    "5000": { "label": "MLflow Tracking", "onAutoForward": "notify" },
    "5001": { "label": "MLflow Serve - Instance 1", "onAutoForward": "notify" },
    "5002": { "label": "MLflow Serve - Instance 2", "onAutoForward": "notify" },
    "5003": { "label": "MLflow Serve - Instance 3", "onAutoForward": "notify" }
  },
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "ms-azuretools.vscode-docker"]
    }
  }
}
